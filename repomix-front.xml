<file path="src/pages/OrdersDashboard.css">
.od * {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ── Search ── */
.od-search-wrap {
  display: flex;
  align-items: center;
  max-width: 360px;
  height: 40px;
  background: #fff;
  border: 1px solid #E5E7EB;
  border-radius: 8px;
  transition: border-color 0.14s, box-shadow 0.14s;
}

.od-search-wrap:focus-within {
  border-color: #1353a7;
  box-shadow: 0 0 0 3px rgba(19, 83, 167, 0.08);
}

.od-search-icon {
  display: flex;
  align-items: center;
  padding-left: 12px;
  color: #9CA3AF;
  pointer-events: none;
  flex-shrink: 0;
  margin-left: 18px !important;
}

.od-search {
  font-family: 'Poppins', sans-serif;
  font-size: 13px;
  flex: 1;
  padding: 0 12px 0 8px;
  border: none;
  background: transparent;
  color: #0D0D0D;
  outline: none;
  height: 100%;
  margin-left: 18px !important;
}

.od-search::placeholder {
  color: #9CA3AF;
}

/* ── Table ── */
.od-table-wrap {
  background: #fff;
  border: 1px solid #E5E7EB;
  border-radius: 12px;
  overflow: visible;
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.05);
}

.od-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.od-table thead {
  background: #F9FAFB;
  border-bottom: 1px solid #E5E7EB;
}

.od-table th {
  padding: 12px 16px;
  text-align: left;
  font-size: 11px;
  font-weight: 600;
  color: #6B7280;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  white-space: nowrap;
}

.od-table th.right,
.od-table td.right {
  text-align: right;
}

.od-table td {
  padding: 14px 16px;
  border-bottom: 1px solid #F3F4F6;
  vertical-align: middle;
  color: #0D0D0D;
}

.od-table tbody tr:last-child td {
  border-bottom: none;
}

.od-table tbody tr:hover td {
  background: #FAFAFA;
}

.od-id {
  font-weight: 700;
  font-size: 13px;
  color: #1353a7;
}

.od-customer-name {
  font-weight: 600;
  font-size: 13px;
}

.od-customer-city {
  font-size: 11.5px;
  color: #9CA3AF;
  margin-top: 2px;
}

.od-total {
  font-weight: 700;
}

/* ── Status ── */
.od-status-wrap {
  position: relative;
  display: inline-block;
}

.od-status-row {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.od-status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: 'Poppins', sans-serif;
  font-size: 12px;
  font-weight: 600;
  border-radius: 20px;
  padding: 5px 16px;
  white-space: nowrap;
  width: 100%;
}

.od-s-pending {
  background: #fef9c3;
  color: #b45309;
}

.od-s-processing {
  background: #dbeafe;
  color: #1d4ed8;
}

.od-s-shipped {
  background: #ede9fe;
  color: #7c3aed;
}

.od-s-transit {
  background: #ffedd5;
  color: #c2410c;
}

.od-s-delivered {
  background: #dcfce7;
  color: #16a34a;
}

.od-chevron-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border: none;
  background: transparent;
  cursor: pointer;
  color: #6B7280;
  border-radius: 4px;
  padding: 0;
  transition: background 0.12s;
}

.od-chevron-btn:hover {
  background: #F3F4F6;
}

/* Dropdown */
.od-status-dropdown {
  position: absolute;
  top: calc(100% + 6px);
  z-index: 300;
  background: #fff;
  border: 1px solid #E5E7EB;
  border-radius: 10px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  min-width: 180px;
  overflow: hidden;
  animation: od-fade-in 0.12s ease;
}

@keyframes od-fade-in {
  from {
    opacity: 0;
    transform: translateY(-4px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.od-status-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 20px;
  font-family: 'Poppins', sans-serif;
  font-size: 13px;
  font-weight: 400;
  cursor: pointer;
  color: #374151;
  transition: background 0.1s;
  margin-left: 8px !important;
  margin-top: 5px !important;
}

.od-status-option:hover {
  background: #F9FAFB;
}

.od-status-option.active {
  font-weight: 600;
}

/* ── Icon button ── */
.od-icon-btn {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
  border-radius: 7px;
  cursor: pointer;
  color: #6B7280;
  transition: all 0.14s;
  margin-left: auto;
}

.od-icon-btn:hover {
  background: #F3F4F6;
  color: #1353a7;
}

.od-empty {
  text-align: center;
  padding: 48px 20px;
  color: #9CA3AF;
  font-size: 13px;
}

/* ── Modal ── */
.od-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.od-modal {
  background: #fff;
  border-radius: 14px;
  width: 520px;
  height: 500px;
  max-width: 95vw;
  max-height: 95vh;
  overflow-y: auto;
  padding: 36px 40px 32px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
}

.od-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28px;
}

.od-modal-title {
  font-size: 17px;
  font-weight: 600;
  color: #0D0D0D;
  margin-left: 18px !important;
  margin-top: 18px !important;
}

.od-close-btn {
  width: 30px;
  height: 30px;
  border: none;
  background: transparent;
  border-radius: 7px;
  cursor: pointer;
  color: #6B7280;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.14s;
  margin-top: 14px !important;
  margin-right: 14px !important;
}

.od-close-btn:hover {
  background: #F3F4F6;
  color: #0D0D0D;
}

/* Modal sections */
.od-section {
  margin-bottom: 36px;
  margin-left: 18px !important;
  margin-top: 18px !important;
}

.od-section-title {
  font-size: 15px;
  font-weight: 700;
  color: #0D0D0D;
  margin-bottom: 10px !important;
}

.od-info-name {
  font-size: 13.5px;
  font-weight: 500;
  color: #374151;
  margin-bottom: 2px;
}

.od-info-sub {
  font-size: 13px;
  color: #6B7280;
  margin-top: 8px !important;
}

/* Items */
.od-item-row {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 20px 0;
  border-bottom: 1px solid #F3F4F6;
  margin-top: 15px !important;
}

.od-item-row:last-child {
  border-bottom: none;
}

.od-item-img {
  width: 56px;
  height: 56px;
  border-radius: 8px;
  object-fit: cover;
  background: #F3F4F6;
  flex-shrink: 0;
}

.od-item-name {
  font-size: 13.5px;
  font-weight: 600;
  color: #0D0D0D;
}

.od-item-sub {
  font-size: 12px;
  color: #9CA3AF;
  margin-top: 3px;
}

.od-item-price {
  font-size: 16px;
  font-weight: 700;
  flex-shrink: 0;
  margin-right: 18px !important;
}

/* Total row */
.od-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20px;
  border-top: 1px solid #E5E7EB;
  margin-top: 15px !important;
  margin-bottom: 15px !important;
}

.od-total-label {
  font-size: 15px;
  font-weight: 700;
  color: #0D0D0D;
  margin-left: 18px !important;
  margin-top: 10px !important;
}

.od-total-val {
  font-size: 15px;
  font-weight: 700;
  color: #dc2626;
  margin-right: 18px !important;
  margin-top: 10px !important;
}

/* ── Tracking code ── */
.od-tracking-row {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-top: 6px;
}

.od-tracking-input {
  flex: 1;
  height: 38px;
  max-width: 420px;
  padding: 0 12px;
  border: 1.5px solid #E5E7EB;
  border-radius: 8px;
  font-family: 'Poppins', sans-serif;
  font-size: 13px;
  font-weight: 600;
  color: #0D0D0D;
  letter-spacing: 1px;
  text-transform: uppercase;
  outline: none;
  transition: border-color 0.14s, box-shadow 0.14s;
}

.od-tracking-input::placeholder {
  font-weight: 400;
  letter-spacing: 0;
  color: #9CA3AF;
  text-transform: none;
}

.od-tracking-input:focus {
  border-color: #1353a7;
  box-shadow: 0 0 0 3px rgba(19, 83, 167, 0.08);
}

.od-tracking-save-btn {
  height: 38px;
  width: 65px;
  padding: 0 18px;
  background: #1353a7;
  color: #fff;
  border: none;
  border-radius: 8px;
  font-family: 'Poppins', sans-serif;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.14s;
  white-space: nowrap;
}

.od-tracking-save-btn:hover {
  background: #063c81;
}

.od-tracking-feedback {
  margin-top: 6px;
