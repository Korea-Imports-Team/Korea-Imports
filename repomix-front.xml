.od-tracking-link {
  display: inline-block;
  margin-top: 8px;
  font-size: 12.5px;
  font-weight: 600;
  color: #1353a7;
  text-decoration: underline;
  text-underline-offset: 2px;
}

.od-tracking-link:hover {
  color: #063c81;
}
