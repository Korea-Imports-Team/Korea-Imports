        </div>
        <div style={{ display: "flex", gap: 10, alignItems: "center" }}>
          {/* Threshold rápido */}
          <div className="pd-threshold-inline">
            <span className="pd-threshold-inline-label">Alertar abaixo de</span>
            <input
