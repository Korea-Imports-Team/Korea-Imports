import { useState, useEffect } from 'react';
import { ChevronDown, ChevronUp, RefreshCw, Shield, HelpCircle } from 'lucide-react';
import styles from './PoliciesPage.module.css';

// ─── Dados ────────────────────────────────────────────────────────────────────
const FAQ_ITEMS = [
