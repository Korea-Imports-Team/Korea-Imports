.page {
  min-height: calc(100vh - 80px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  background: var(--color-gray-100);
}

.card {
  background: var(--color-white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card-hover);
  padding: 2.5rem;
  width: 100%;
  max-width: 440px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Logo */
.logo {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  margin-bottom: 1.5rem;
}

.logoImg {
  width: 48px;
  height: 48px;
  object-fit: cover;
  border-radius: 50%;
}

.logoName {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 1.0625rem;
  color: var(--color-dark);
}

/* Title */
.title {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--color-dark);
  text-align: center;
  margin-bottom: 0.375rem;
}

.subtitle {
  font-size: 0.875rem;
  color: var(--color-gray-500);
  text-align: center;
  margin-bottom: 1.75rem;
}

/* Google Button */
.googleBtn {
  width: 100%;
  height: 46px;
  border: 1.5px solid var(--color-gray-200);
  border-radius: var(--radius-sm);
  background: var(--color-white);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  font-family: var(--font-body);
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--color-dark);
  cursor: pointer;
  transition: all var(--transition-fast);
  margin-bottom: 1.25rem;
}

.googleBtn:hover {
  border-color: var(--color-gray-400);
  background: var(--color-gray-100);
}

/* Divider */
.divider {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1.25rem;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--color-gray-200);
}

.divider span {
  font-size: 0.8125rem;
  color: var(--color-gray-400);
  white-space: nowrap;
}

/* Form */
.form {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}

.labelRow {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-dark);
}

.forgotLink {
  font-size: 0.8125rem;
  color: var(--color-primary);
  font-weight: 500;
  transition: opacity var(--transition-fast);
}

.forgotLink:hover {
  opacity: 0.75;
}

.inputWrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.inputIcon {
  position: absolute;
  left: 0.875rem;
  color: var(--color-gray-400);
  pointer-events: none;
}

.input {
  width: 100%;
  height: 46px;
  padding: 0 2.75rem 0 2.5rem;
  border: 1.5px solid var(--color-gray-200);
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: 0.9375rem;
  color: var(--color-dark);
  background: var(--color-white);
  outline: none;
  transition: border-color var(--transition-fast);
}

.input::placeholder {
  color: var(--color-gray-400);
}

.input:focus {
  border-color: var(--color-primary);
}

.eyeBtn {
  position: absolute;
  right: 0.875rem;
  color: var(--color-gray-400);
  display: flex;
  align-items: center;
  background: none;
  border: none;
  cursor: pointer;
  transition: color var(--transition-fast);
}

.eyeBtn:hover {
  color: var(--color-dark);
}

/* Terms */
.terms {
  font-size: 0.8125rem;
  color: var(--color-gray-500);
  line-height: 1.5;
}

/* Submit */
.submitBtn {
  width: 100%;
  height: 48px;
  background: var(--color-primary);
  color: var(--color-white);
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: 600;
  border: none;
  cursor: pointer;
  transition: background var(--transition-fast);
  margin-top: 0.25rem;
}

.submitBtn:hover {
  background: var(--color-primary-dark);
}

/* Switch */
.switchText {
  margin-top: 1.25rem;
  font-size: 0.875rem;
  color: var(--color-gray-500);
}

.switchLink {
  color: var(--color-primary);
  font-weight: 600;
  transition: opacity var(--transition-fast);
}

.switchLink:hover {
  opacity: 0.75;
}

/* Password validation */
.passwordRules {
  margin-top: 0.5rem;
}

.passwordValid {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.8125rem;
  font-weight: 600;
  color: #16A34A;
}

.rulesList {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.rule {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.8125rem;
}

.rulePassed {
  color: #16A34A;
}

.ruleFailed {
  color: #D72638;
}

.inputValid {
  border-color: #16A34A !important;
}

.inputInvalid {
  border-color: #D72638 !important;
}

.submitBtn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.errorMsg {
  width: 100%;
  padding: 0.75rem 1rem;
  background: #FEF2F2;
  border: 1px solid #FECACA;
  border-radius: var(--radius-sm);
  font-size: 0.875rem;
  color: #D72638;
  text-align: center;
  margin-bottom: 0.5rem;
}
</file>

