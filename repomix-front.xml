/* ============================================
   CONFIRMATION PAGE
   ============================================ */

.page {
    padding: 2rem 0 5rem;
}

.wrapper {
    display: flex;
    flex-direction: column;
    gap: 0;
}

/* ── Success header ── */
.successHeader {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: #f0fdf4;
    border: 1.5px solid #bbf7d0;
    border-radius: var(--radius-lg);
    padding: 1.5rem 2rem;
    margin-bottom: 2rem;
}

.checkCircle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #16a34a;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.successTitle {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: #14532d;
}

.successSub {
    font-size: 0.9375rem;
    color: #166534;
    margin-top: 4px;
}

.successDate {
    font-size: 0.8125rem;
    color: #16a34a;
    margin-top: 6px;
    font-weight: 500;
}

/* ── Layout ── */
.layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2rem;
    align-items: start;
}

.leftCol {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

/* ── Payment box ── */
